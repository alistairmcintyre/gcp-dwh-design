# Local Airflow 3 image for the `airflow` docker-compose profile.
#
# Providers only, no dbt: Airflow and dbt cannot co-install (protobuf 4 vs 5/6), so dbt runs in its own
# container both here (DockerOperator) and in production (KubernetesPodOperator).
#   * cncf.kubernetes - so the production KPO DAGs parse and are viewable in the UI
#   * docker          - for the local `dbt_local_demo` DAG
#   * standard        - BashOperator etc., split out of core in Airflow 3
FROM apache/airflow:3.1.3-python3.12

RUN pip install --no-cache-dir \
      apache-airflow-providers-cncf-kubernetes \
      apache-airflow-providers-docker \
      apache-airflow-providers-standard \
      --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-3.1.3/constraints-3.12.txt"
