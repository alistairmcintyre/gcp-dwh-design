# Copy to .env and adjust. Loaded by the Makefile, the data generator, and dbt (via env_var()).

# ---- Local DuckDB (dev target) ----
DBT_TARGET=dev
# Path to the local DuckDB database file (source AND destination of every model locally).
DUCKDB_PATH=./data/dev.duckdb

# ---- BigQuery (prod target / Cloud Composer) ----
GCP_PROJECT=your-gcp-project
# Dataset the marts/staging models are written to.
BQ_DATASET=analytics
# Dataset the raw source tables live in (loaded by the generator with --target bigquery).
BQ_RAW_DATASET=raw
BQ_LOCATION=EU
# Threads for the BigQuery target.
BQ_THREADS=4

# ---- Local Docker Compose UIs (docker-compose.yml: `dagster` / `airflow` profiles) ----
# Absolute path to this repo on the host. Needed by the local Airflow `dbt_local_demo` DAG: DockerOperator
# launches a sibling dbt container that bind-mounts <HOST_PROJECT_DIR>/data for the DuckDB file.
HOST_PROJECT_DIR=/absolute/path/to/gcp-dwh-design
# Set to your host UID on Linux so mounted files are writable: `id -u`.
AIRFLOW_UID=50000
# Host docker group id, so the Airflow scheduler can use the mounted docker socket: `getent group docker | cut -d: -f3`.
DOCKER_GID=999

# ---- Alerting (optional; both orchestrators no-op if unset) ----
# Slack incoming webhook — Dagster run-failure sensor + Airflow on_failure_callback post here.
SLACK_WEBHOOK_URL=
# Dagster-only extra sinks (see dagster/README.md): Slack bot token + channel, or SMTP email.
DAGSTER_SLACK_BOT_TOKEN=
DAGSTER_SLACK_CHANNEL=#data-alerts
DAGSTER_SMTP_HOST=
DAGSTER_ALERT_EMAIL_FROM=
DAGSTER_ALERT_EMAIL_PASSWORD=
DAGSTER_ALERT_EMAIL_TO=
